# ===================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ===================================================================

# Docker Registry và Image Tag
DOCKER_REGISTRY=quanghd
IMAGE_TAG=latest

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5050

# Backend URL cho Frontend
BACKEND_URL=http://localhost:5050

# Database Connection String
DB_CONNECTION_STRING=11

# JWT Settings
JWT_SECRET_KEY=11
JWT_ISSUER=11
JWT_AUDIENCE=11
JWT_EXPIRY_HOURS=24

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh 