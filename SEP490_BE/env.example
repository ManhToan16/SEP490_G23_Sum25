# ===================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ===================================================================

# Docker Registry và Image Tag
DOCKER_REGISTRY=quanghd
IMAGE_TAG=latest

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=5050

# Backend URL cho Frontend
BACKEND_URL=http://localhost:5050

# Database Connection String
DB_CONNECTION_STRING=Server=host.docker.internal;Database=KhanhAnClinic;User Id=sa;Password=YourStrong@Passw0rd123;TrustServerCertificate=true;MultipleActiveResultSets=true;

# Redis Connection String
REDIS_CONNECTION_STRING=my-redis:6379,abortConnect=false

# JWT Settings
JWT_SECRET_KEY=s
JWT_ISSUER=SEP490_BE
JWT_AUDIENCE=SEP490_FE
JWT_EXPIRY_HOURS=24

# Timezone
TIMEZONE=Asia/Ho_Chi_Minh 