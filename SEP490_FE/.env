# 🏥 Clinic Management System - Environment Variables Template
# Copy file này thành .env và điều chỉnh giá trị phù hợp

# ==============================================
# 🌐 API Configuration
# ==============================================
VITE_API_URL=http://70.153.24.53:5050/api
VITE_BACKEND_URL=http://70.153.24.53:5050

PORT = 8080

# ==============================================
# 🏢 Application Configuration  
# ==============================================
VITE_APP_NAME=Phòng Khám Đa Khoa ABC
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Hệ thống quản lý phòng khám hiện đại

# ==============================================
# 🔐 Authentication & Security
# ==============================================
VITE_JWT_SECRET=clinic-secret-key-2024
VITE_SESSION_TIMEOUT=3600000
VITE_REFRESH_TOKEN_TIMEOUT=604800000

# ==============================================
# 🌍 Multi-language Support
# ==============================================
VITE_DEFAULT_LANGUAGE=vi
VITE_SUPPORTED_LANGUAGES=vi,en
VITE_TRANSLATION_CACHE_TTL=300000
VITE_TRANSLATION_AUTO_REFRESH=true

# ==============================================
# 📡 Real-time Features
# ==============================================
VITE_WEBSOCKET_URL=ws://localhost:8080/ws
VITE_REALTIME_ENABLED=true

# ==============================================
# 📁 File Upload & Storage
# ==============================================
VITE_FILE_UPLOAD_URL=http://localhost:8080/api/upload
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# ==============================================
# 🏥 Clinic Specific Settings
# ==============================================
VITE_CLINIC_NAME=Phòng Khám Đa Khoa ABC
VITE_CLINIC_ADDRESS=123 Đường ABC, Quận XYZ, TP.HCM
VITE_CLINIC_PHONE=+84-123-456-789
VITE_CLINIC_EMAIL=contact@clinic-abc.com
VITE_CLINIC_WORKING_HOURS=07:00-18:00

# ==============================================
# 📅 Appointment System
# ==============================================
VITE_APPOINTMENT_SLOT_DURATION=30
VITE_APPOINTMENT_ADVANCE_BOOKING_DAYS=30
VITE_APPOINTMENT_CANCELLATION_HOURS=24

# ==============================================
# 💳 Payment Integration (Optional)
# ==============================================
VITE_PAYMENT_ENABLED=false
VITE_PAYMENT_GATEWAY_URL=
VITE_PAYMENT_MERCHANT_ID=

# ==============================================
# 📊 Analytics & Monitoring
# ==============================================
VITE_ANALYTICS_ENABLED=false
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ==============================================
# 🔔 Notification Settings
# ==============================================
VITE_NOTIFICATION_ENABLED=true
VITE_PUSH_NOTIFICATION_ENABLED=false
VITE_EMAIL_NOTIFICATION_ENABLED=true
VITE_SMS_NOTIFICATION_ENABLED=false

# ==============================================
# 🚀 Development Settings
# ==============================================
# Dev server port (for vite.config.ts)
PORT=3000

# Debug mode
VITE_DEBUG_MODE=true
VITE_SHOW_DEV_TOOLS=true

# ==============================================
# 🔧 Feature Flags
# ==============================================
VITE_FEATURE_ONLINE_CONSULTATION=true
VITE_FEATURE_TELEMEDICINE=false
VITE_FEATURE_PHARMACY_INTEGRATION=true
VITE_FEATURE_LAB_INTEGRATION=false
VITE_FEATURE_INSURANCE_CHECK=false

# ==============================================
# 🎨 UI/UX Configuration
# ==============================================
VITE_THEME_DEFAULT=light
VITE_THEME_SWITCHING_ENABLED=true
VITE_COMPACT_MODE=false

# ==============================================
# 📱 PWA Configuration
# ==============================================
VITE_PWA_ENABLED=true
VITE_PWA_CACHE_STRATEGY=NetworkFirst

# ==============================================
# 🏗️ Build Configuration
# ==============================================
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=false
VITE_BUILD_TARGET=es2020 