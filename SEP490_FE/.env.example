# ===========================================
# 🌍 CẤU HÌNH HỆ THỐNG DỊCH THUẬT
# ===========================================

# URL cơ sở API cho Manual Translation Reload
VITE_API_URL=https://be.khanhanclinic.io.vn/api

# Bật/tắt manual translation reload system
# true = Manual Reload Mode (hiển thị UI controls để reload thủ công)
# false = Static Mode (chỉ sử dụng static translations, không gọi API)
VITE_ENABLE_RUNTIME_RELOAD=false

# Bật debug logging cho hệ thống dịch thuật
VITE_DEBUG_TRANSLATIONS=false

# Ngôn ngữ mặc định (vi | en)
VITE_DEFAULT_LANGUAGE=vi

# Tự động phát hiện ngôn ngữ từ trình duyệt
VITE_AUTO_DETECT_LANGUAGE=true

# ===========================================
# 🏥 CẤU HÌNH ỨNG DỤNG
# ===========================================

# Môi trường ứng dụng
VITE_APP_ENV=development

# Tiêu đề ứng dụng
VITE_APP_TITLE=Hệ Thống Quản Lý Phòng Khám

# Phiên bản ứng dụng
VITE_APP_VERSION=1.0.0

# ===========================================
# 🔗 CÁC ENDPOINT API BACKEND
# ===========================================

# URL cơ sở API backend chính
VITE_BACKEND_URL=https://be.khanhanclinic.io.vn

# URL WebSocket cho cập nhật thời gian thực
VITE_WEBSOCKET_URL=ws://localhost:8000/ws

# Endpoint upload file
VITE_UPLOAD_URL=http://localhost:8000/upload

# ===========================================
# 🔐 BẢO MẬT & XÁC THỰC
# ===========================================

# Khóa lưu trữ JWT token trong localStorage
VITE_TOKEN_KEY=auth_token

# Thời gian hết hạn phiên (milliseconds) - 1 giờ
VITE_SESSION_TIMEOUT=3600000

# Bật cookie bảo mật (yêu cầu HTTPS trong production)
VITE_SECURE_COOKIES=false

# ===========================================
# 🎨 GIAO DIỆN & TRẢI NGHIỆM NGƯỜI DÙNG
# ===========================================

# Theme mặc định (light | dark | system)
VITE_DEFAULT_THEME=system

# Lưu trữ preference theme trong localStorage
VITE_PERSIST_THEME=true

# Thời gian animation transition (milliseconds)
VITE_ANIMATION_DURATION=200

# ===========================================
# 📊 GIÁM SÁT & PHÂN TÍCH
# ===========================================

# Bật báo cáo lỗi tự động
VITE_ENABLE_ERROR_REPORTING=false

# URL dịch vụ báo cáo lỗi (ví dụ: Sentry)
VITE_ERROR_REPORTING_URL=

# Bật giám sát hiệu suất ứng dụng
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Google Analytics Tracking ID (tùy chọn)
VITE_GA_TRACKING_ID=

# ===========================================
# 🛠️ CÔNG CỤ PHÁT TRIỂN
# ===========================================

# Hiển thị React Developer Tools
VITE_ENABLE_REACT_DEVTOOLS=true

# Hiển thị Redux DevTools
VITE_ENABLE_REDUX_DEVTOOLS=true

# Hiển thị error boundary components trong development
VITE_SHOW_ERROR_BOUNDARIES=true

# ===========================================
# 📱 CẤU HÌNH PWA (PROGRESSIVE WEB APP)
# ===========================================

# Bật tính năng Progressive Web App
VITE_ENABLE_PWA=false

# Chiến lược cache cho Service Worker
# networkFirst: Ưu tiên network, fallback cache
# cacheFirst: Ưu tiên cache, fallback network
VITE_SW_CACHE_STRATEGY=networkFirst

# ===========================================
# 🏥 THÔNG TIN PHÒNG KHÁM
# ===========================================

# Số điện thoại phòng khám
VITE_CLINIC_PHONE=+84 28 1234 5678

# Địa chỉ phòng khám
VITE_CLINIC_ADDRESS=123 Đường ABC, Quận 1, TP.HCM

# Email liên hệ
VITE_CLINIC_EMAIL=contact@clinic.com

# Giờ làm việc
VITE_CLINIC_HOURS=8:00 - 18:00 (Thứ 2 - Thứ 7)
